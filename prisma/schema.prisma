// Datenmodell der Überführungs-Software (MySQL)

generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "linux-musl-openssl-3.0.x", "debian-openssl-3.0.x"]
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------------
// Benutzer & Authentifizierung (Auth.js)
// ---------------------------------------------------------------------------

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String    @unique
  emailVerified DateTime?
  image         String?   @db.Text
  passwordHash  String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  accounts           Account[]
  sessions           Session[]
  memberships        Membership[]
  invitationsSent    Invitation[] @relation("InvitedBy")
  ordersCreated      Order[]      @relation("OrderCreatedBy")
  ordersAssigned     Order[]      @relation("OrderAssignedTo")
  filesUploaded      File[]
  protocolsPerformed Protocol[]
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// ---------------------------------------------------------------------------
// Instanzen (Mandanten) & Teams
// ---------------------------------------------------------------------------

enum Role {
  OWNER
  ADMIN
  MEMBER
}

model Organization {
  id        String   @id @default(cuid())
  name      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Stammdaten für Rechnungen & Protokolle
  companyName   String?
  ownerName     String?
  street        String?
  zip           String?
  city          String?
  country       String? @default("Deutschland")
  phone         String?
  email         String?
  website       String?
  taxNumber     String?
  vatId         String?
  bankName      String?
  accountHolder String?
  iban          String?
  bic           String?
  logoFileId    String?

  // Rechnungseinstellungen
  invoicePrefix      String   @default("RE-")
  nextInvoiceNumber  Int      @default(1)
  nextOrderNumber    Int      @default(1)
  nextCustomerNumber Int      @default(1)
  paymentTermDays    Int      @default(14)
  defaultVatRate     Decimal  @default(19.00) @db.Decimal(5, 2)
  smallBusiness      Boolean  @default(false) // Kleinunternehmerregelung § 19 UStG
  defaultPricePerKm  Decimal? @db.Decimal(10, 2)
  invoiceIntroText   String?  @db.Text
  invoiceFooterText  String?  @db.Text
  protocolTerms      String?  @db.Text

  memberships Membership[]
  invitations Invitation[]
  customers   Customer[]
  orders      Order[]
  invoices    Invoice[]
  files       File[]
  vehicles    Vehicle[]
}

model Membership {
  id             String   @id @default(cuid())
  userId         String
  organizationId String
  role           Role     @default(MEMBER)
  createdAt      DateTime @default(now())

  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([userId, organizationId])
  @@index([organizationId])
}

model Invitation {
  id             String    @id @default(cuid())
  organizationId String
  email          String
  role           Role      @default(MEMBER)
  token          String    @unique
  expiresAt      DateTime
  acceptedAt     DateTime?
  invitedById    String?
  createdAt      DateTime  @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  invitedBy    User?        @relation("InvitedBy", fields: [invitedById], references: [id], onDelete: SetNull)

  @@index([organizationId])
}

// ---------------------------------------------------------------------------
// Dateien (Fotos, Belege, Logo)
// ---------------------------------------------------------------------------

model File {
  id             String   @id @default(cuid())
  organizationId String
  storageKey     String   @unique
  originalName   String?
  mimeType       String
  size           Int
  uploadedById   String?
  createdAt      DateTime @default(now())

  organization Organization      @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  uploadedBy   User?             @relation(fields: [uploadedById], references: [id], onDelete: SetNull)
  photos       Photo[]
  expenses     Expense[]
  vehicleDocs  VehicleDocument[]

  @@index([organizationId])
}

// ---------------------------------------------------------------------------
// Kunden
// ---------------------------------------------------------------------------

enum CustomerType {
  COMPANY
  PRIVATE
}

model Customer {
  id             String       @id @default(cuid())
  organizationId String
  number         Int
  type           CustomerType @default(COMPANY)
  companyName    String?
  firstName      String?
  lastName       String?
  email          String?
  phone          String?
  street         String?
  zip            String?
  city           String?
  country        String?      @default("Deutschland")
  vatId          String?
  notes          String?      @db.Text
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  orders       Order[]
  invoices     Invoice[]
  vehicles     Vehicle[]

  @@unique([organizationId, number])
  @@index([organizationId])
}

// ---------------------------------------------------------------------------
// Fahrzeuge (Stammdaten – werden beim Speichern von Aufträgen automatisch gepflegt)
// ---------------------------------------------------------------------------

model Vehicle {
  id                String   @id @default(cuid())
  organizationId    String
  customerId        String? // zuletzt zugeordneter Kunde
  licensePlate      String?
  vin               String?
  make              String?
  model             String?
  color             String?
  firstRegistration String?
  vehicleType       String?
  notes             String?  @db.Text
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  organization Organization      @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  customer     Customer?         @relation(fields: [customerId], references: [id], onDelete: SetNull)
  orders       Order[]
  documents    VehicleDocument[]

  @@index([organizationId, vin])
  @@index([organizationId, licensePlate])
  @@index([customerId])
}

// Dokumente zum Fahrzeug, z. B. Fahrzeugschein (Foto oder PDF)
model VehicleDocument {
  id        String   @id @default(cuid())
  vehicleId String
  fileId    String
  kind      String   @default("REGISTRATION") // REGISTRATION = Fahrzeugschein, OTHER
  createdAt DateTime @default(now())

  vehicle Vehicle @relation(fields: [vehicleId], references: [id], onDelete: Cascade)
  file    File    @relation(fields: [fileId], references: [id], onDelete: Cascade)

  @@index([vehicleId])
}

// ---------------------------------------------------------------------------
// Aufträge
// ---------------------------------------------------------------------------

enum OrderStatus {
  DRAFT // Angelegt
  PLANNED // Geplant
  IN_TRANSIT // Unterwegs (Abholung erfolgt)
  DELIVERED // Zugestellt
  INVOICED // Abgerechnet
  CANCELLED // Storniert
}

enum TransportMode {
  DRIVEN // Überführung auf eigener Achse
  TRAILER // Anhänger
  TRUCK // Transporter / LKW
}

enum PricingType {
  FLAT
  PER_KM
}

model Order {
  id             String        @id @default(cuid())
  organizationId String
  number         Int
  customerId     String
  vehicleId      String?
  status         OrderStatus   @default(DRAFT)
  transportMode  TransportMode @default(DRIVEN)
  reference      String? // Referenz / Bestellnummer des Kunden

  // Abholung
  pickupName    String?
  pickupStreet  String?
  pickupZip     String?
  pickupCity    String?
  pickupContact String?
  pickupPhone   String?
  pickupDate    DateTime?

  // Zustellung
  deliveryName    String?
  deliveryStreet  String?
  deliveryZip     String?
  deliveryCity    String?
  deliveryContact String?
  deliveryPhone   String?
  deliveryDate    DateTime?

  // Fahrzeug
  licensePlate      String?
  make              String?
  model             String?
  vin               String?
  color             String?
  firstRegistration String?
  vehicleType       String?

  // Abrechnung
  distanceKm      Decimal?    @db.Decimal(10, 1)
  durationMinutes Int? // geschätzte Fahrzeit laut Routenberechnung
  skippedSteps    Json? // bewusst übersprungene Ablaufschritte, z. B. ["pickupPhotos"]
  pricingType     PricingType @default(FLAT)
  price           Decimal?    @db.Decimal(10, 2) // Pauschale (netto)
  pricePerKm      Decimal?    @db.Decimal(10, 2)

  notes        String?  @db.Text
  createdById  String?
  assignedToId String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  customer     Customer     @relation(fields: [customerId], references: [id], onDelete: Restrict)
  vehicle      Vehicle?     @relation(fields: [vehicleId], references: [id], onDelete: SetNull)
  createdBy    User?        @relation("OrderCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  assignedTo   User?        @relation("OrderAssignedTo", fields: [assignedToId], references: [id], onDelete: SetNull)
  photos       Photo[]
  damages      Damage[]
  protocols    Protocol[]
  expenses     Expense[]
  invoices     Invoice[]
  events       OrderEvent[]

  @@unique([organizationId, number])
  @@index([organizationId, status])
  @@index([customerId])
  @@index([vehicleId])
}

model OrderEvent {
  id        String   @id @default(cuid())
  orderId   String
  userName  String?
  message   String
  createdAt DateTime @default(now())

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId])
}

enum Stage {
  PICKUP
  DELIVERY
}

model Photo {
  id        String   @id @default(cuid())
  orderId   String
  fileId    String
  stage     Stage    @default(PICKUP)
  category  String   @default("OTHER")
  caption   String?
  createdAt DateTime @default(now())

  order   Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  file    File     @relation(fields: [fileId], references: [id], onDelete: Cascade)
  damages Damage[]

  @@index([orderId])
}

model Damage {
  id          String   @id @default(cuid())
  orderId     String
  stage       Stage    @default(PICKUP)
  area        String
  type        String
  severity    String   @default("MINOR")
  description String?  @db.Text
  photoId     String?
  createdAt   DateTime @default(now())

  order Order  @relation(fields: [orderId], references: [id], onDelete: Cascade)
  photo Photo? @relation(fields: [photoId], references: [id], onDelete: SetNull)

  @@index([orderId])
}

model Protocol {
  id                String    @id @default(cuid())
  orderId           String
  type              Stage
  performedAt       DateTime?
  location          String?
  mileage           Int?
  fuelLevel         Int? // in Achteln (0-8) bzw. Ladestand in %
  checklist         Json?
  exteriorClean     String?
  interiorClean     String?
  notes             String?   @db.Text
  handoverName      String?
  signatureCustomer String?   @db.MediumText
  signatureDriver   String?   @db.MediumText
  performedById     String?
  completedAt       DateTime?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  order       Order @relation(fields: [orderId], references: [id], onDelete: Cascade)
  performedBy User? @relation(fields: [performedById], references: [id], onDelete: SetNull)

  @@unique([orderId, type])
}

// ---------------------------------------------------------------------------
// Belege / Spesen
// ---------------------------------------------------------------------------

model Expense {
  id          String    @id @default(cuid())
  orderId     String
  fileId      String?
  category    String    @default("OTHER")
  vendor      String?
  date        DateTime?
  amountGross Decimal   @default(0) @db.Decimal(10, 2)
  vatRate     Decimal   @default(19) @db.Decimal(5, 2)
  currency    String    @default("EUR")
  description String?
  rebillable  Boolean   @default(true)
  aiExtracted Boolean   @default(false)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)
  file  File? @relation(fields: [fileId], references: [id], onDelete: SetNull)

  @@index([orderId])
}

// ---------------------------------------------------------------------------
// Rechnungen
// ---------------------------------------------------------------------------

enum InvoiceStatus {
  DRAFT
  ISSUED
  PAID
  CANCELLED
}

model Invoice {
  id             String        @id @default(cuid())
  organizationId String
  orderId        String?
  customerId     String
  number         String? // wird beim Festschreiben vergeben
  status         InvoiceStatus @default(DRAFT)
  issueDate      DateTime?
  dueDate        DateTime?
  serviceDate    DateTime?
  paidAt         DateTime?
  recipient      String        @db.Text // Anschrift (Snapshot)
  smallBusiness  Boolean       @default(false)
  introText      String?       @db.Text
  footerText     String?       @db.Text
  netTotal       Decimal       @default(0) @db.Decimal(12, 2)
  vatTotal       Decimal       @default(0) @db.Decimal(12, 2)
  grossTotal     Decimal       @default(0) @db.Decimal(12, 2)
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  organization Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  order        Order?        @relation(fields: [orderId], references: [id], onDelete: SetNull)
  customer     Customer      @relation(fields: [customerId], references: [id], onDelete: Restrict)
  items        InvoiceItem[]

  @@unique([organizationId, number])
  @@index([organizationId, status])
}

model InvoiceItem {
  id          String  @id @default(cuid())
  invoiceId   String
  position    Int
  description String  @db.Text
  quantity    Decimal @default(1) @db.Decimal(10, 2)
  unit        String  @default("Stk.")
  unitPrice   Decimal @db.Decimal(12, 2) // netto
  vatRate     Decimal @default(19) @db.Decimal(5, 2)

  invoice Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  @@index([invoiceId])
}
