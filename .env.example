# --- Datenbank -------------------------------------------------------------
DATABASE_URL="mysql://app:app@localhost:3306/cartransport"

# --- Auth.js ---------------------------------------------------------------
# Zufälligen Wert erzeugen: openssl rand -base64 32
AUTH_SECRET="bitte-aendern"
# Öffentliche URL der Anwendung (für OAuth-Callbacks & Einladungslinks)
AUTH_URL="http://localhost:3000"
APP_URL="http://localhost:3000"
AUTH_TRUST_HOST=true

# Google Login (optional) – https://console.cloud.google.com/apis/credentials
# Redirect-URI: {APP_URL}/api/auth/callback/google
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""

# Apple Login (optional) – Services ID + generiertes Client-Secret (JWT)
# Redirect-URI: {APP_URL}/api/auth/callback/apple
AUTH_APPLE_ID=""
AUTH_APPLE_SECRET=""

# --- Datei-Speicher ---------------------------------------------------------
# "local" (Docker-Volume) oder "s3" (S3-kompatibel, empfohlen bei mehreren Instanzen)
STORAGE_DRIVER="local"
UPLOAD_DIR="./data/uploads"
S3_BUCKET=""
S3_REGION="eu-central-1"
S3_ENDPOINT=""
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""
S3_FORCE_PATH_STYLE=true

# --- Automatische Erkennung (Kennzeichen, Fahrzeug, FIN, Belege) ----------------
# Ohne ANTHROPIC_API_KEY: lokale Texterkennung (OCR) auf dem eigenen Server –
#   es werden keine Bilder an Dritte übermittelt.
# Mit ANTHROPIC_API_KEY: Erkennung per KI (Claude) – deutlich genauer, aber die
#   Bilder werden an Anthropic (USA) übertragen (AV-Vertrag/Datenschutzerklärung!).
ANTHROPIC_API_KEY=""
ANTHROPIC_MODEL="claude-opus-5-5"
# Lokale OCR komplett abschalten (dann nur manuelle Eingabe, falls kein KI-Schlüssel)
OCR_ENABLED=true

# --- E-Mail für Einladungen (optional) -------------------------------------
SMTP_HOST=""
SMTP_PORT=587
SMTP_USER=""
SMTP_PASSWORD=""
SMTP_FROM="Überführung <no-reply@example.com>"
